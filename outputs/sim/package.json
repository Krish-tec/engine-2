{
  "name": "quantumorbit-sim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e/ --ignore-snapshots",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts -g \"@a11y\"",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:soak": "playwright test tests/e2e/soak.spec.ts"
  },
  "dependencies": {
    "satellite.js": "^7.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.1.1"
  }
}
